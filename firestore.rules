rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Fields: uid (string), username (string), avatar (string), xp (int), level (int), totalXP (int), streak (int), lastActive (string), badges (list), role (string), createdAt (string), dailyQuests (list), unlockedLevels (list)
    //
    // Subcollection: users/{userId}/progress
    // Fields: levelId (string), subjectId (string), completed (bool), stars (int), bestScore (int), unlocked (bool)
    //
    // Collection: subjects
    // Fields: name (string), icon (string), description (string), color (string)
    //
    // Collection: attempts
    // Fields: userId (string), levelId (string), score (int), xpEarned (int), completedAt (string)
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == "luutrithon1996@gmail.com");
    }

    function isValidUser(data) {
      return data.username is string && data.username.size() > 0 && data.username.size() < 50 &&
             data.xp is int && data.xp >= 0 &&
             data.level is int && data.level >= 1 &&
             data.role in ['user', 'admin'];
    }

    function isValidUserLevelProgress(data) {
      return data.levelId is string &&
             data.subjectId is string &&
             data.completed is bool &&
             data.stars is int && data.stars >= 0 && data.stars <= 3;
    }

    // Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == 'user';
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role) || isAdmin();

      match /progress/{progressId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      match /levels/{levelId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    match /levels/{levelId}/questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /attempts/{attemptId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
